Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: world
      Cell Size: 0.5
      Plane Cell Count: 30
      Color: 120; 120; 124
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel (segun el mixto)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.8
      Frames:
        All Enabled: false
        world: {Value: true}
        reference: {Value: true}
        base_footprint: {Value: true}
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR que reciben los localizadores (/scan_gated)
      Enabled: true
      Topic:
        Value: /scan_gated
        Reliability Policy: Best Effort
      Size (m): 0.04
      Color Transformer: FlatColor
      Color: 255; 255; 255
    - Class: rviz_default_plugins/Odometry
      Name: Ground truth (verde)
      Enabled: true
      Topic: {Value: /ground_truth/odom}
      Keep: 400
      Position Tolerance: 0.08
      Angle Tolerance: 0.3
      Shape:
        Value: Arrow
        Color: 0; 210; 0
        Shaft Length: 0.18
        Shaft Radius: 0.012
        Head Length: 0.06
        Head Radius: 0.03
      Covariance: {Value: false}
    - Class: rviz_default_plugins/Odometry
      Name: Mixto (azul)
      Enabled: true
      Topic: {Value: /localization/odom}
      Keep: 400
      Position Tolerance: 0.08
      Angle Tolerance: 0.3
      Shape:
        Value: Arrow
        Color: 40; 110; 255
        Shaft Length: 0.18
        Shaft Radius: 0.012
        Head Length: 0.06
        Head Radius: 0.03
      Covariance: {Value: false}
    - Class: rviz_default_plugins/Odometry
      Name: Lidar (amarillo)
      Enabled: true
      Topic: {Value: /lidar/localization/odom}
      Keep: 400
      Position Tolerance: 0.08
      Angle Tolerance: 0.3
      Shape:
        Value: Arrow
        Color: 255; 200; 0
        Shaft Length: 0.18
        Shaft Radius: 0.012
        Head Length: 0.06
        Head Radius: 0.03
      Covariance: {Value: false}
    - Class: rviz_default_plugins/Odometry
      Name: Encoders (rojo)
      Enabled: true
      Topic: {Value: /encoders/localization/odom}
      Keep: 400
      Position Tolerance: 0.08
      Angle Tolerance: 0.3
      Shape:
        Value: Arrow
        Color: 235; 40; 40
        Shaft Length: 0.18
        Shaft Radius: 0.012
        Head Length: 0.06
        Head Radius: 0.03
      Covariance: {Value: false}
  Global Options:
    Fixed Frame: world
    Background Color: 40; 40; 44
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 170
      X: -1.0
      Y: -0.2
Window Geometry:
  Width: 1300
  Height: 850
