<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rota_bringup</name>
  <version>0.0.0</version>
  <description>Launch files, RViz configs and robot profiles for the rota_* nodes, and the Gazebo simulation.</description>
  <maintainer email="jkaplan@udesa.edu.ar">juan-kaplan</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rota_localization</exec_depend>
  <exec_depend>rota_mapping</exec_depend>
  <exec_depend>rota_control</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
